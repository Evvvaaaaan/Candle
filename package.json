{
  "name": "candle-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "dev:contract": "node scripts/serve.mjs --contract",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/release.browser.mjs",
    "build": "node scripts/build.mjs",
    "format": "prettier --write src/js/core-flow.js src/js/*-*.mjs 'src/js/screens/*.mjs' 'src/js/ui/*.mjs' scripts/*.mjs tests/*.mjs",
    "format:check": "prettier --check src/js/core-flow.js src/js/*-*.mjs 'src/js/screens/*.mjs' 'src/js/ui/*.mjs' scripts/*.mjs tests/*.mjs",
    "check": "npm run format:check && npm test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "playwright": "1.59.1",
    "prettier": "3.6.2"
  }
}
